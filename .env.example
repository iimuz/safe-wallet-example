# Private key for Node.js examples (without 0x prefix)
# ⚠️ NEVER commit your actual private key to version control!
# ⚠️ Use a test account with small amounts of testnet ETH only!
PRIVATE_KEY=your_private_key_here

# RPC URL for the network you want to use
# Sepolia Testnet (recommended for testing)
RPC_URL=https://rpc.sepolia.org

# Other networks:
# Ethereum Mainnet: https://eth.llamarpc.com
# Polygon: https://polygon-rpc.com
# Gnosis Chain: https://rpc.gnosischain.com
